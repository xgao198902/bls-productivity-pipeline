# Copy this file to .env (already gitignored) and fill in your own contact email.
# Then, before running any `databricks bundle` command, load it into your shell:
#
#   set -a && source .env && set +a
#
# The Databricks CLI reads any BUNDLE_VAR_<name> environment variable as the
# value for the bundle variable <name> - see databricks.yml's `contact_email`
# variable. This is required: BLS's access policy
# (https://www.bls.gov/bls/pss.htm) blocks robots that don't identify a way to
# contact the requester, and the ingest_bls_pr task fails fast if this is blank.

BUNDLE_VAR_contact_email=you@example.com
